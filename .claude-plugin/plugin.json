{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "shift-mcp-server",
  "version": "0.2.0",
  "description": "Lightweight coordination layer for multiple AI agents working on the same codebase simultaneously.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/shift-mcp-server#readme",
  "repository": "https://github.com/cyanheads/shift-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "stdio",
    "streamable-http",
    "multi-agent",
    "coordination",
    "ai-agents",
    "agent-coordination",
    "claude-code",
    "typescript"
  ],
  "mcpServers": {
    "shift-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/shift-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "SHIFT_WORKSPACE": "${user_config.workspace}",
        "SHIFT_STATE_DIR": "${user_config.state_dir}"
      }
    }
  },
  "userConfig": {
    "workspace": { "type": "string", "title": "Workspace", "description": "Shared exact-match namespace for agents working on one project.", "required": true },
    "state_dir": { "type": "string", "title": "State directory", "description": "Shared writable local SQLite directory; blank uses ~/.local/state/shift-mcp-server.", "default": "" }
  }
}
