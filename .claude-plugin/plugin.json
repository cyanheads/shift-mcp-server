{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "shift-mcp-server",
  "version": "0.1.7",
  "description": "Lightweight coordination layer for multiple AI agents working on the same codebase simultaneously.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/shift-mcp-server#readme",
  "repository": "https://github.com/cyanheads/shift-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "multi-agent",
    "coordination",
    "ai-agents",
    "agent-coordination",
    "claude-code"
  ],
  "mcpServers": {
    "shift-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/shift-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
