{
  "manifest_version": "0.3",
  "name": "shift-mcp-server",
  "display_name": "shift-mcp-server",
  "version": "0.1.8",
  "description": "Lightweight coordination layer for multiple AI agents working on the same codebase simultaneously.",
  "author": {
    "name": "cyanheads"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyanheads/shift-mcp-server"
  },
  "homepage": "https://github.com/cyanheads/shift-mcp-server#readme",
  "license": "Apache-2.0",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "NODE_ENV": "production",
        "SHIFT_WORKSPACE": "${user_config.workspace}",
        "SHIFT_STATE_DIR": "${user_config.state_dir}"
      }
    }
  },
  "compatibility": {
    "runtimes": {
      "node": ">=24.0.0"
    }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "user_config": {
    "workspace": {
      "type": "string",
      "title": "Workspace",
      "description": "Shared exact-match namespace for agents working on one project.",
      "required": true
    },
    "state_dir": {
      "type": "string",
      "title": "State directory",
      "description": "Shared writable local SQLite directory; blank uses ~/.local/state/shift-mcp-server.",
      "default": ""
    }
  }
}
